{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.php"
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "posterit-office",
          "region": "us-central1"
        }
      }
    ]
  }
}
